# Local signing config. Copy this file to `keystore.properties` and fill in your
# values. NEVER commit the real file or your .keystore — it is git-ignored.
#
# To generate a keystore locally:
#   keytool -genkeypair -v -keystore yangshipin-release.keystore -alias yangshipin \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# For CI, instead set the GitHub Actions secrets:
#   KEYSTORE_BASE64 (base64 of your .keystore), KEYSTORE_PASSWORD,
#   KEY_ALIAS, KEY_PASSWORD

storeFile=yangshipin-release.keystore
storePassword=CHANGE_ME
keyAlias=yangshipin
keyPassword=CHANGE_ME
